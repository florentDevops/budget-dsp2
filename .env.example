# --- Enable Banking (https://enablebanking.com/cp/applications) ---
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_KEY_PATH=keys/private.pem
ENABLE_BANKING_REDIRECT_URL=https://budget-dsp2.local:8000/callback
ENABLE_BANKING_COUNTRY=FR
# Durée du consentement demandé (plafonnée par chaque banque, 180 jours en général)
CONSENT_DAYS=180
# Historique récupéré à la première synchro (la banque peut limiter à 90 jours)
HISTORY_DAYS=365

# --- Classification LLM ---
# "ollama" (local, gratuit mais lent sur un petit modèle), "gemini" (gratuit, hébergé,
# recommandé) ou "anthropic" (payant, nécessite ANTHROPIC_API_KEY)
LLM_PROVIDER=gemini
OLLAMA_BASE_URL=http://localhost:11434
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# LLM_MODEL=gemini-3.8-flash  # ou qwen2.5:3b (ollama) / claude-haiku-4-5-20251001 (anthropic)

# --- Stockage ---
DB_PATH=data/budget.db
